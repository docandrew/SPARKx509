obj/
lib/
alire/
config/
scratch/
tests/tests
# Every test crate under tests/ (smoke, nc, revocation, ...) builds into
# its own bin/ and obj/ and gets an Alire cache; none of that is source.
tests/*/bin/
tests/*/obj/
tests/*/alire/
tests/*/config/

# Ignore generated .ads and .adb
*b__*

# Ignore objects, .ali, stderr and stdout
*.o
*.a
*.ali
*.bexch
*.stderr
*.stdout
